  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session               ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  briefExtractionResult BriefExtractionResult?
  draftResult           DraftResult?
  toolCalls             AgentToolCall[]
  pendingActions        PendingAction[]

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([correlationId])
}

// One row per assistant-agent tool call within an `agent-turn` run.
model AgentToolCall {
  id           String              @id @default(uuid())
  workspaceId  String
  sessionId    String
  jobId        String
  toolCallId   String
  toolName     String
  input        Json?
  output       Json?
  status       AgentToolCallStatus @default(RUNNING)
  errorMessage String?
  durationMs   Int?
  startedAt    DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime?           @db.Timestamptz(3)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session      ChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  job          WorkflowJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, toolCallId])
  @@index([sessionId, startedAt])
  @@index([workspaceId, toolName, startedAt])
}

// A record change proposed by the assistant agent; executed only after a user approves it.
model PendingAction {
  id              String              @id @default(uuid())
  workspaceId     String
  sessionId       String
  jobId           String
  correlationId   String
  actionType      String
  payload         Json
  summary         String
  details         String[]            @default([])
  status          PendingActionStatus @default(PENDING)
  idempotencyKey  String              @unique
  result          Json?
  errorMessage    String?
  expiresAt       DateTime            @db.Timestamptz(3)
  decidedByUserId String?
  decidedAt       DateTime?           @db.Timestamptz(3)
  declineReason   String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session         ChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  job             WorkflowJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([jobId, status])
}

model BriefExtractionResult {
  id              String        @id @default(uuid())
  jobId           String        @unique
  workspaceId     String
  sessionId       String
  messageId       String?
  // Draft document type id from the @law/brief-extraction registry (validated in code).
  documentType    String        @default("LAWSUIT")
  brief           Json
  confidence      Float?
  missingFields   Json          @default("[]")
  appliedCaseId   String?
  appliedTaskKeys String[]      @default([])
  promptChars     Int
  truncated       Boolean       @default(false)
  model           String
  errorCode       String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  job             WorkflowJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session         ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message         ChatMessage?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  appliedCase     Case?         @relation("BriefAppliedCase", fields: [appliedCaseId], references: [id], onDelete: SetNull)
  draftResults    DraftResult[]

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([appliedCaseId])
}

model DraftResult {
  id                String                 @id @default(uuid())
  jobId             String                 @unique
  workspaceId       String
  sessionId         String
  caseId            String?
  messageId         String?
  briefResultId     String?
  // Draft document type id from the @law/brief-extraction registry (validated in code).
  documentType      String                 @default("LAWSUIT")
  documentText      String                 @db.Text
  finalDocumentText String?                @db.Text
  warnings          String[]               @default([])
  promptChars       Int
  truncated         Boolean                @default(false)
  model             String
  approvalStatus    DraftApprovalStatus    @default(READY_FOR_SIGNOFF)
  reviewedByUserId  String?
  reviewedAt        DateTime?              @db.Timestamptz(3)
  reviewNote        String?
  previousDraftId   String?
  errorCode         String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  job               WorkflowJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session           ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  case              Case?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  message           ChatMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  briefResult       BriefExtractionResult? @relation(fields: [briefResultId], references: [id], onDelete: SetNull)
  previousDraft     DraftResult?           @relation("DraftResultHistory", fields: [previousDraftId], references: [id], onDelete: SetNull)
  modifiedDrafts    DraftResult[]          @relation("DraftResultHistory")
  citations         DraftCitation[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, caseId])
  @@index([workspaceId, documentType])
  @@index([sessionId, createdAt])
  @@index([approvalStatus, reviewedAt])
}

/// Read-only AI analysis of a document (contract review). `result` holds the
/// structured review; `citations` snapshots the legal sources it used.
model DocumentAnalysis {
  id            String      @id @default(uuid())
  workspaceId   String
  sessionId     String
  caseId        String?
  /// The agent-turn job that produced it.
  jobId         String?
  /// CONTRACT_REVIEW or CASE_TIMELINE (validated in code).
  kind          String
  /// doc:<id> or att:<id> (review); case:<id> or session:<id> (timeline)
  documentRef   String
  documentTitle String
  /// Review checklist id from @law/contract-review; null for a timeline.
  contractType  String?
  clientSide    String?
  result        Json
  citations     Json        @default("[]")
  promptChars   Int
  truncated     Boolean     @default(false)
  model         String
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  case          Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([workspaceId, sessionId, createdAt])
  @@index([workspaceId, caseId])
}

// Snapshotted at generation time so a draft's sources stay stable even if the corpus changes later.
model DraftCitation {
  id            String      @id @default(uuid())
  draftResultId String
  chunkId       String?
  marker        Int
  articleNumber String?
  sourceTitle   String
  sourceUrl     String
  snippet       String      @db.Text
  score         Float
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  draftResult   DraftResult @relation(fields: [draftResultId], references: [id], onDelete: Cascade)
  chunk         LegalChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([draftResultId, marker])
  @@index([chunkId])
}

model TenantAuditEvent {
  id          String     @id @default(uuid())
  userId      String?
  workspaceId String?
  eventType   String
  outcome     String
  requestId   String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model StorageConnection {
  id           String              @id @default(uuid())
  workspaceId  String
  providerType StorageProviderType
  enabled      Boolean             @default(true)
  isDefault    Boolean             @default(false)
  configRef    String
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  locations    FileLocation[]
  operations   UploadOperation[]

  @@unique([workspaceId, configRef])
  @@index([workspaceId, isDefault, enabled])
}

model DocumentFolder {
  id          String           @id @default(uuid())
  workspaceId String
  name        String
  parentId    String?
  archivedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      DocumentFolder?  @relation("FolderTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  children    DocumentFolder[] @relation("FolderTree")
  documents   Document[]

  @@unique([id, workspaceId])
  // Migration uses NULLS NOT DISTINCT so root siblings are also unique.
  @@unique([workspaceId, parentId, name])
}

model Document {
  id                      String            @id @default(uuid())
  workspaceId             String
  title                   String
  category                String?
  folderId                String?
  folder                  DocumentFolder?   @relation(fields: [folderId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  currentVersionId        String?           @unique
  archivedAt              DateTime?         @db.Timestamptz(3)
  archivedByUserId        String?
  aiAccess                Boolean           @default(false)
  aiAccessChangedAt       DateTime?         @db.Timestamptz(3)
  aiAccessChangedByUserId String?
  createdByUserId         String
  updatedByUserId         String
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)
  workspace               Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentVersion          DocumentVersion?  @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdBy               User              @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy               User              @relation("DocumentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedBy              User?             @relation("DocumentArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  versions                DocumentVersion[] @relation("DocumentVersions")
  cases                   DocumentCase[]
  clients                 DocumentClient[]
  operations              UploadOperation[]
  chatAttachments         ChatAttachment[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([workspaceId, title])
  @@index([workspaceId, category])
}

model DocumentCase {
  documentId  String
  caseId      String
  workspaceId String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([documentId, caseId])
  @@index([workspaceId, caseId])
  @@index([caseId])
}

model DocumentClient {
  documentId  String
  clientId    String
  workspaceId String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([documentId, clientId])
  @@index([workspaceId, clientId])
  @@index([clientId])
}

model DocumentVersion {
  id               String                         @id @default(uuid())
  documentId       String
  workspaceId      String
  versionNumber    Int
  storedFileId     String
  originalFilename String
  uploadedByUserId String
  /// Text extracted for the assistant (Serbian Latin); filled lazily on first read.
  extractionStatus ChatAttachmentExtractionStatus @default(PENDING)
  extractedText    String?                        @db.Text
  sourceScript     ChatAttachmentSourceScript?
  extractionError  String?
  extractedAt      DateTime?                      @db.Timestamptz(3)
  contentId        String?
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  document         Document                       @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor       Document?                      @relation("DocumentCurrentVersion")
  workspace        Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storedFile       StoredFile                     @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  uploadedBy       User                           @relation("DocumentVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  content          DocumentContent?               @relation(fields: [contentId], references: [id], onDelete: SetNull)
  operations       UploadOperation[]

  @@unique([documentId, versionNumber])
  @@index([workspaceId, documentId, createdAt])
  @@index([storedFileId])
  @@index([contentId])
}

model StoredFile {
  id               String              @id @default(uuid())
  workspaceId      String
  lifecycle        StoredFileLifecycle @default(PENDING)
  detectedMimeType String?
  sizeBytes        BigInt              @default(0)
  sha256           String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  finalizedAt      DateTime?           @db.Timestamptz(3)
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  locations        FileLocation[]
  versions         DocumentVersion[]
  operations       UploadOperation[]

  @@index([workspaceId, lifecycle])
  @@index([workspaceId, sha256])
}

enum DocumentContentStatus {
  PENDING
  EXTRACTING
  EMBEDDING
  CLASSIFYING
  READY
  FAILED
  UNSUPPORTED
}

enum DocumentKind {
  ID_CARD
  PASSPORT
  APR_EXCERPT
  COURT_DECISION
  ADMIN_DECISION
  OTHER
}

enum DocumentFactSubjectType {
  PERSON
  COMPANY
  DECISION
}

model DocumentContent {
  id                  String                      @id @default(uuid())
  workspaceId         String
  sha256              String
  mimeType            String
  sizeBytes           Int
  status              DocumentContentStatus       @default(PENDING)
  failedStep          String?
  error               String?
  extractedText       String?                     @db.Text
  sourceScript        ChatAttachmentSourceScript?
  truncated           Boolean                     @default(false)
  pipelineVersion     Int                         @default(0)
  embeddingModel      String?
  embeddingDimensions Int?
  documentKind        DocumentKind?
  kindConfidence      Float?
  processedAt         DateTime?                   @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks              DocumentContentChunk[]
  facts               DocumentFact[]
  versions            DocumentVersion[]
  chatAttachments     ChatAttachment[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId, status])
}

model DocumentContentChunk {
  id                  String                       @id @default(uuid())
  contentId           String
  workspaceId         String
  ordinal             Int
  text                String                       @db.Text
  charStart           Int
  charEnd             Int
  embedding           Unsupported("vector(1024)")?
  embeddingModel      String
  embeddingDimensions Int
  content             DocumentContent              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([contentId, ordinal])
  @@index([workspaceId, contentId])
}

model DocumentFact {
  id              String                  @id @default(uuid())
  contentId       String
  workspaceId     String
  subjectKey      String
  subjectType     DocumentFactSubjectType
  subjectRole     String?
  field           String
  value           String                  @db.Text
  normalizedValue String?                 @db.Text
  quote           String                  @db.Text
  charStart       Int?
  confidence      Float
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  content         DocumentContent         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contentId])
}

model FileLocation {
  id                  String            @id @default(uuid())
  storedFileId        String
  workspaceId         String
  storageConnectionId String
  storageKey          String
  state               FileLocationState @default(PENDING)
  isActive            Boolean           @default(false)
  verifiedAt          DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  storedFile          StoredFile        @relation(fields: [storedFileId], references: [id], onDelete: Cascade)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection          StorageConnection @relation(fields: [storageConnectionId], references: [id], onDelete: Restrict)
  operations          UploadOperation[]

  @@unique([storageConnectionId, storageKey])
  @@index([storedFileId, isActive])
  @@index([workspaceId])
}

model UploadOperation {
  id                  String                 @id @default(uuid())
  workspaceId         String
  idempotencyKey      String
  actorUserId         String
  purpose             UploadOperationPurpose
  status              UploadOperationStatus  @default(ACCEPTED)
  requestFingerprint  String
  documentId          String?
  documentVersionId   String?
  storedFileId        String
  fileLocationId      String
  storageConnectionId String
  errorCode           String?
  lastHeartbeatAt     DateTime               @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?              @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor               User                   @relation("UploadOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  document            Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion     DocumentVersion?       @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  storedFile          StoredFile             @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  fileLocation        FileLocation           @relation(fields: [fileLocationId], references: [id], onDelete: Restrict)
  storageConnection   StorageConnection      @relation(fields: [storageConnectionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, lastHeartbeatAt])
  @@index([storedFileId])
}

enum WorkEntryStatus {
  RUNNING
  PROPOSED
  CONFIRMED
  BILLED
  WRITTEN_OFF
}

enum WorkEntryTreatment {
  RETAINER
  AT
  HOURLY
  NON_BILLABLE
  UNDECIDED
}

enum WorkEntrySource {
  MANUAL
  TIMER
  QUICK_CAPTURE
  TASK
  EVENT
  DEADLINE
  ACTIVITY
  EMAIL
}

enum RetainerRule {
  HOURLY
  AT
  ABSORBED
}

model ServiceCategory {
  id          String                      @id @default(uuid())
  workspaceId String
  name        String
  active      Boolean                     @default(true)
  order       Int                         @default(0)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workEntries WorkEntry[]
  retainers   RetainerAgreementCategory[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active, order])
}

model WorkEntry {
  id                String             @id @default(uuid())
  workspaceId       String
  userId            String
  clientId          String
  caseId            String?
  taskId            String?
  workDate          DateTime           @db.Date
  minutes           Int?
  timerStartedAt    DateTime?          @db.Timestamptz(3)
  /// One-sentence summary; required once the entry is created or confirmed (a running timer may still be blank).
  title             String             @default("") @db.VarChar(200)
  description       String             @default("") @db.Text
  serviceCategoryId String?
  treatment         WorkEntryTreatment @default(UNDECIDED)
  status            WorkEntryStatus    @default(PROPOSED)
  writeOffReason    String?            @db.Text
  source            WorkEntrySource    @default(MANUAL)
  sourceType        String?
  sourceId          String?
  invoiceLineId     String?
  aiParsed          Boolean            @default(false)
  createdByUserId   String
  updatedByUserId   String
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user              User               @relation("WorkEntryPerformer", fields: [userId], references: [id], onDelete: Restrict)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  case              Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  serviceCategory   ServiceCategory?   @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  invoiceLine       InvoiceLine?       @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("WorkEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy         User               @relation("WorkEntryUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, sourceType, sourceId])
  @@index([workspaceId, taskId, workDate])
  @@index([workspaceId, clientId, workDate])
  @@index([workspaceId, userId, workDate])
  @@index([workspaceId, status])
  @@index([invoiceLineId])
  @@index([caseId])
}

model RetainerAgreement {
  id                   String                      @id @default(uuid())
  workspaceId          String
  clientId             String
  title                String
  monthlyFee           Decimal                     @db.Decimal(18, 2)
  currency             String
  validFrom            DateTime                    @db.Date
  validTo              DateTime?                   @db.Date
  includedMinutes      Int?
  overageRule          RetainerRule
  overageHourlyRate    Decimal?                    @db.Decimal(18, 2)
  outOfScopeRule       RetainerRule
  outOfScopeHourlyRate Decimal?                    @db.Decimal(18, 2)
  active               Boolean                     @default(true)
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  categories           RetainerAgreementCategory[]

  @@index([workspaceId, clientId, validFrom])
}

model RetainerAgreementCategory {
  workspaceId         String
  retainerAgreementId String
  serviceCategoryId   String
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  retainerAgreement   RetainerAgreement @relation(fields: [retainerAgreementId], references: [id], onDelete: Cascade)
  serviceCategory     ServiceCategory   @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([retainerAgreementId, serviceCategoryId])
  @@index([workspaceId, serviceCategoryId])
}

model ClientBillingProfile {
  id          String    @id @default(uuid())
  workspaceId String
  clientId    String    @unique
  hourlyRate  Decimal?  @db.Decimal(18, 2)
  currency    String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model UserRate {
  id            String    @id @default(uuid())
  workspaceId   String
  userId        String
  hourlyValue   Decimal   @db.Decimal(18, 2)
  currency      String
  effectiveFrom DateTime  @db.Date
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, effectiveFrom])
}
