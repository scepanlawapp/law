generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserGender {
  MALE
  FEMALE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  LAWYER
  MEMBER
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageDecision {
  LEGAL
  NON_LEGAL
  UNCLEAR
}

enum ChatAttachmentExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ChatAttachmentSourceScript {
  LATIN
  CYRILLIC
  MIXED
  NONE
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
}

enum PendingActionStatus {
  PENDING
  EXECUTING
  APPROVED
  DECLINED
  FAILED
  EXPIRED
}

enum AgentToolCallStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ThemePreference {
  MIDNIGHT
  DEEP_NAVY
  CHARCOAL
  DARK_TEAL
  BURGUNDY
  IVORY
}

enum LanguagePreference {
  SR
  EN
}

enum DateTimeFormatPreference {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

enum DraftApprovalStatus {
  DRAFT
  READY_FOR_SIGNOFF
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum InvoiceLineStatus {
  UNBILLED
  RESERVED
  BILLED
  CANCELLED
}

enum PriceSourceScope {
  CLIENT_AGREEMENT
  WORKSPACE_PUBLIC_REFERENCE
  COMPANY_CATALOG
  CASE_OVERRIDE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VOIDED
}

enum FinanceMutationOperation {
  CREATE_INVOICE
  SEND_INVOICE
}

enum SefEnvironment {
  DEMO
  PRODUCTION
}

enum SefSubmissionState {
  PREPARED
  SENDING
  SUBMITTED
  FAILED
  UNKNOWN
}

enum InvoiceNumberResetPolicy {
  NEVER
  YEARLY
  MONTHLY
}

enum PaymentMethodPreference {
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum ExchangeRateSource {
  NBS_MIDDLE
  NBS_BUY
  NBS_SELL
  MANUAL
}

enum PaymentQrStandard {
  NBS_IPS
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PROSPECT
}

enum ClientContactStatus {
  ACTIVE
  INACTIVE
}

enum ActivityType {
  NOTE
  PHONE_CALL
  MEETING
  EMAIL
  OTHER
}

enum ActivitySource {
  MANUAL
  SYSTEM
  AI
}

enum EventType {
  MEETING
  HEARING
  CALL
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DeadlineType {
  COURT
  STATUTORY
  CONTRACTUAL
  INTERNAL
  OTHER
}

enum DeadlineStatus {
  OPEN
  SATISFIED
  CANCELLED
}

enum NotificationType {
  DEADLINE_ASSIGNED
  DEADLINE_DUE_SOON
  DEADLINE_DUE_TODAY
  DEADLINE_OVERDUE
  DEADLINE_CHANGED
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_DUE_TODAY
  TASK_OVERDUE
  EVENT_UPCOMING
  EVENT_CHANGED
  EVENT_CANCELLED
  TIMER_RUNNING_LONG
  TIME_REVIEW_REMINDER
  RETAINER_USAGE_80
  RETAINER_USAGE_100
}

enum CaseStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StorageProviderType {
  LOCAL
}

enum StoredFileLifecycle {
  PENDING
  AVAILABLE
  FAILED
  ABANDONED
}

enum FileLocationState {
  PENDING
  AVAILABLE
  FAILED
}

enum UploadOperationStatus {
  ACCEPTED
  WRITING
  FINALIZING
  COMMITTED
  FAILED
  ABANDONED
}

enum UploadOperationPurpose {
  CREATE_DOCUMENT
  ADD_VERSION
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String?
  firstName             String?
  lastName              String?
  username              String?                @unique
  phone                 String?
  jobTitle              String?
  gender                UserGender?
  avatarUrl             String?
  status                UserStatus             @default(INVITED)
  passwordChangedAt     DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  memberships           WorkspaceMember[]
  sessions              AuthSession[]
  tokens                AuthToken[]
  auditEvents           AuditEvent[]
  organizedEvents       Event[]                @relation("EventOrganizer")
  createdEvents         Event[]                @relation("EventCreator")
  eventAssignees        EventAssignee[]
  assignedTasks         Task[]                 @relation("TaskAssignee")
  createdTasks          Task[]                 @relation("TaskCreator")
  responsibleDeadlines  Deadline[]             @relation("DeadlineResponsible")
  createdDeadlines      Deadline[]             @relation("DeadlineCreator")
  completedTasks        Task[]                 @relation("TaskCompleter")
  satisfiedDeadlines    Deadline[]             @relation("DeadlineSatisfier")
  activityLogs          ActivityLog[]          @relation("ActivityActor")
  chatSessions          ChatSession[]          @relation("ChatSessionCreator")
  createdDocuments      Document[]             @relation("DocumentCreator")
  updatedDocuments      Document[]             @relation("DocumentUpdater")
  archivedDocuments     Document[]             @relation("DocumentArchiver")
  uploadedVersions      DocumentVersion[]      @relation("DocumentVersionUploader")
  uploadOperations      UploadOperation[]      @relation("UploadOperationActor")
  settings              UserSettings?
  performedInvoiceLines InvoiceLine[]          @relation("InvoiceLinePerformer")
  createdInvoiceLines   InvoiceLine[]          @relation("InvoiceLineCreator")
  updatedInvoiceLines   InvoiceLine[]          @relation("InvoiceLineUpdater")
  cancelledInvoiceLines InvoiceLine[]          @relation("InvoiceLineCanceller")
  authoredPriceSources  PriceSource[]          @relation("PriceSourceAuthor")
  authoredPriceVersions PriceSourceVersion[]   @relation("PriceSourceVersionAuthor")
  notifications         Notification[]
  sharedInvoices        Invoice[]              @relation("InvoiceSharer")
  voidedInvoices        Invoice[]              @relation("InvoiceVoider")
  createdInvoices       Invoice[]              @relation("InvoiceCreator")
  updatedInvoices       Invoice[]              @relation("InvoiceUpdater")
  sefSubmissions        InvoiceSefSubmission[] @relation("InvoiceSefSubmitter")
  workEntries           WorkEntry[]            @relation("WorkEntryPerformer")
  createdWorkEntries    WorkEntry[]            @relation("WorkEntryCreator")
  updatedWorkEntries    WorkEntry[]            @relation("WorkEntryUpdater")
  rates                 UserRate[]
}

model UserSettings {
  userId                    String                   @id
  theme                     ThemePreference          @default(CHARCOAL)
  language                  LanguagePreference       @default(SR)
  accentColor               String                   @default("GOLD")
  finish                    String                   @default("METALLIC")
  workspaceNotifications    Boolean                  @default(true)
  notificationPreferences   Json?
  dateTimeFormat            DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  timeZone                  String                   @default("Europe/Belgrade")
  timeReviewReminderEnabled Boolean                  @default(false)
  timeReviewReminderTime    String                   @default("17:30")
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(3)
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                          String                       @id @default(uuid())
  name                        String
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  memberships                 WorkspaceMember[]
  auditEvents                 AuditEvent[]
  chatSessions                ChatSession[]
  chatAttachments             ChatAttachment[]
  workflowJobs                WorkflowJob[]
  agentToolCalls              AgentToolCall[]
  pendingActions              PendingAction[]
  briefExtractionResults      BriefExtractionResult[]
  draftResults                DraftResult[]
  documentAnalyses            DocumentAnalysis[]
  config                      WorkspaceConfig?
  organizationSettings        OrganizationSettings?
  bankAccounts                BankAccount[]
  invoiceNumberSequences      InvoiceNumberSequenceState[]
  domainCounters              DomainCounter[]
  tags                        Tag[]
  caseTypes                   CaseType[]
  practiceAreas               PracticeArea[]
  clients                     Client[]
  cases                       Case[]
  clientActivities            ClientActivity[]
  caseActivities              CaseActivity[]
  caseResponsibilities        CaseResponsibility[]
  events                      Event[]
  eventAssignees              EventAssignee[]
  eventClients                EventClient[]
  eventAttendees              EventAttendee[]
  tasks                       Task[]
  deadlines                   Deadline[]
  activityLogs                ActivityLog[]
  tenantAuditEvents           TenantAuditEvent[]
  legalSources                LegalSource[]
  storageConnections          StorageConnection[]
  documentFolders             DocumentFolder[]
  documents                   Document[]
  documentCases               DocumentCase[]
  documentClients             DocumentClient[]
  documentVersions            DocumentVersion[]
  storedFiles                 StoredFile[]
  documentContents            DocumentContent[]
  documentContentChunks       DocumentContentChunk[]
  documentFacts               DocumentFact[]
  fileLocations               FileLocation[]
  uploadOperations            UploadOperation[]
  invoiceLines                InvoiceLine[]
  invoiceLineCases            InvoiceLineCase[]
  priceSources                PriceSource[]
  priceSourceVersions         PriceSourceVersion[]
  invoices                    Invoice[]
  invoiceSefSubmissions       InvoiceSefSubmission[]
  financeMutations            FinanceMutationRequest[]
  notifications               Notification[]
  workEntries                 WorkEntry[]
  serviceCategories           ServiceCategory[]
  retainerAgreements          RetainerAgreement[]
  retainerAgreementCategories RetainerAgreementCategory[]
  clientBillingProfiles       ClientBillingProfile[]
  userRates                   UserRate[]
}

model OrganizationSettings {
  workspaceId                        String                   @id
  legalName                          String?
  displayName                        String?
  taxId                              String?
  registrationNumber                 String?
  addressLine1                       String?
  addressLine2                       String?
  city                               String?
  postalCode                         String?
  countryCode                        String                   @default("RS")
  email                              String?
  phone                              String?
  website                            String?
  jbkjs                              String?
  vatRegistered                      Boolean                  @default(false)
  defaultVatRate                     Decimal?                 @db.Decimal(5, 2)
  availableVatRates                  Json
  defaultTaxCategoryCode             String?
  defaultTaxExemptionReasonCode      String?
  defaultTaxExemptionReasonText      String?
  cashAccountingEnabled              Boolean                  @default(false)
  sefEnabled                         Boolean                  @default(false)
  sefEnvironment                     SefEnvironment           @default(DEMO)
  sefApiKeyCiphertext                String?
  sefApiKeyIv                        String?
  sefApiKeyAuthTag                   String?
  caseNumberPattern                  String                   @default("{YYYY}-{SEQ}")
  invoiceNumberPattern               String                   @default("{YYYY}-{SEQ:6}")
  invoiceNumberStartingSequence      Int                      @default(1)
  invoiceNumberIncrementBy           Int                      @default(1)
  invoiceNumberResetPolicy           InvoiceNumberResetPolicy @default(YEARLY)
  invoiceNumberAllowManualOverride   Boolean                  @default(true)
  defaultPaymentTermDays             Int                      @default(15)
  defaultPaymentMethod               PaymentMethodPreference  @default(BANK_TRANSFER)
  defaultPaymentModel                String?
  paymentReferencePattern            String?
  defaultCurrencyCode                String                   @default("RSD")
  allowedCurrencyCodes               Json
  exchangeRateSource                 ExchangeRateSource       @default(NBS_MIDDLE)
  allowManualExchangeRate            Boolean                  @default(true)
  exchangeRatePrecision              Int                      @default(4)
  amountPrecision                    Int                      @default(2)
  defaultIssuePlace                  String?
  defaultLanguage                    String                   @default("sr-Latn")
  defaultUnitOfMeasure               String?
  defaultNote                        String?                  @db.Text
  defaultFooterText                  String?                  @db.Text
  paymentQrEnabled                   Boolean                  @default(false)
  paymentQrStandard                  PaymentQrStandard        @default(NBS_IPS)
  paymentQrAccountId                 String?
  paymentQrPurposeTemplate           String                   @default("Plaćanje po fakturi {{invoiceNumber}}") @db.Text
  paymentQrReferenceModel            String?
  paymentQrReferenceTemplate         String?                  @db.Text
  includeGeneratedInvoicePdf         Boolean                  @default(false)
  includeUserAttachments             Boolean                  @default(true)
  allowedSefAttachmentFileExtensions Json
  maxSefAttachmentCount              Int?
  maxSefSingleFileSizeMb             Int?
  createdAt                          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                 @updatedAt @db.Timestamptz(3)
  workspace                          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentQrAccount                   BankAccount?             @relation("OrganizationPaymentQrAccount", fields: [paymentQrAccountId], references: [id], onDelete: SetNull)

  @@index([paymentQrAccountId])
}

model BankAccount {
  id            String                 @id @default(uuid())
  workspaceId   String
  name          String
  bankName      String?
  accountNumber String?
  iban          String?
  swiftBic      String?
  currencyCode  String
  isDefault     Boolean                @default(false)
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentQrFor  OrganizationSettings[] @relation("OrganizationPaymentQrAccount")

  @@index([workspaceId, active])
  @@index([workspaceId, isDefault])
}

model InvoiceNumberSequenceState {
  id                String    @id @default(uuid())
  workspaceId       String
  periodKey         String
  lastSequenceValue Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodKey])
}

model WorkspaceConfig {
  workspaceId            String                   @id
  timeZone               String                   @default("Europe/Belgrade")
  dateTimeFormat         DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  workspaceNotifications Boolean                  @default(true)
  officeHours            Json?
  targetHourlyRate       Decimal?                 @db.Decimal(18, 2)
  internalCurrency       String                   @default("RSD")
  defaultVatRate         Decimal                  @default(20) @db.Decimal(5, 2)
  paymentTermDays        Int                      @default(15)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  workspace              Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  message     String
  entityType  String?
  entityId    String?
  metadata    Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?        @db.Timestamptz(3)
  dedupeKey   String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, dedupeKey])
  @@index([workspaceId, userId, createdAt])
  @@index([workspaceId, userId, isRead, createdAt])
}

model DomainCounter {
  workspaceId String
  name        String
  value       Int       @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}

model Tag {
  id              String      @id @default(uuid())
  workspaceId     String
  name            String
  color           String?
  isActive        Boolean     @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clients         ClientTag[]
  cases           CaseTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model CaseType {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model PracticeArea {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model Client {
  id                      String                         @id @default(uuid())
  workspaceId             String
  clientNumber            String
  type                    ClientType
  displayName             String
  firstName               String?
  lastName                String?
  organizationName        String?
  isDomestic              Boolean                        @default(true)
  isPublicSector          Boolean                        @default(false)
  jbkjs                   String?
  jmbg                    String?
  taxNumber               String?
  registrationNumber      String?
  status                  ClientStatus                   @default(ACTIVE)
  email                   String?
  phone                   String?
  website                 String?
  preferredLanguage       String?
  notes                   String?
  customFields            Json?
  responsibleUserId       String?
  createdByUserId         String
  updatedByUserId         String
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addresses               ClientAddress[]                @relation("ClientAddresses")
  identificationDocuments ClientIdentificationDocument[]
  contacts                ClientContact[]
  documentClients         DocumentClient[]
  activities              ClientActivity[]
  cases                   Case[]
  tags                    ClientTag[]
  eventClients            EventClient[]
  tasks                   Task[]
  deadlines               Deadline[]
  activityLogs            ActivityLog[]
  invoiceLines            InvoiceLine[]
  workEntries             WorkEntry[]
  retainerAgreements      RetainerAgreement[]
  billingProfile          ClientBillingProfile?
  priceSources            PriceSource[]
  invoices                Invoice[]

  @@unique([workspaceId, clientNumber])
  @@index([workspaceId, status, displayName])
  @@index([workspaceId, type, status])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model ClientAddress {
  id               String   @id @default(uuid())
  clientId         String
  addressType      String
  street           String
  streetAdditional String?
  city             String
  postalCode       String
  stateOrRegion    String?
  country          String
  note             String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  client           Client   @relation("ClientAddresses", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientIdentificationDocument {
  id          String    @id @default(uuid())
  clientId    String
  type        String
  number      String
  issuedDate  DateTime? @db.Date
  expiredDate DateTime? @db.Date
  country     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientContact {
  id             String              @id @default(uuid())
  clientId       String
  firstName      String
  lastName       String
  position       String?
  email          String?
  phone          String?
  isPrimary      Boolean             @default(false)
  notes          String?
  status         ClientContactStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventAttendees EventAttendee[]

  @@index([clientId, status, lastName, firstName])
}

model ClientActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  clientId        String
  relatedCaseId   String?
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relatedCase     Case?          @relation("ClientActivityRelatedCase", fields: [relatedCaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clientId, activityDate])
  @@index([relatedCaseId])
}

model Case {
  id                   String                  @id @default(uuid())
  workspaceId          String
  caseNumber           String
  clientId             String
  name                 String
  description          String?
  caseTypeId           String?
  practiceAreaId       String?
  status               CaseStatus              @default(DRAFT)
  priority             CasePriority            @default(NORMAL)
  responsibleUserId    String
  openedDate           DateTime?               @db.Timestamptz(3)
  closedDate           DateTime?               @db.Timestamptz(3)
  closingNote          String?
  externalReference    String?
  opposingPartyName    String?
  opposingPartyAddress String?
  confidentialityLevel String?
  customFields         Json?
  createdByUserId      String
  updatedByUserId      String
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  caseType             CaseType?               @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
  practiceArea         PracticeArea?           @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  activities           CaseActivity[]
  clientActivities     ClientActivity[]        @relation("ClientActivityRelatedCase")
  responsibilities     CaseResponsibility[]
  tags                 CaseTag[]
  events               Event[]                 @relation("EventCase")
  tasks                Task[]                  @relation("TaskCase")
  deadlines            Deadline[]              @relation("DeadlineCase")
  activityLogs         ActivityLog[]           @relation("ActivityCase")
  documentCases        DocumentCase[]
  chatSessions         ChatSession[]
  draftResults         DraftResult[]
  documentAnalyses     DocumentAnalysis[]
  appliedBriefs        BriefExtractionResult[] @relation("BriefAppliedCase")
  invoiceLineCases     InvoiceLineCase[]
  priceSources         PriceSource[]
  workEntries          WorkEntry[]

  @@unique([workspaceId, caseNumber])
  @@index([workspaceId, clientId, status, updatedAt])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, caseTypeId, status])
  @@index([workspaceId, practiceAreaId, status])
}

model CaseActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  caseId          String
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([workspaceId, caseId, activityDate])
}

model Event {
  id              String          @id @default(uuid())
  workspaceId     String
  type            EventType
  title           String
  description     String?
