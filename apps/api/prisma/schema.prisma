generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  LAWYER
  MEMBER
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageDecision {
  LEGAL
  NON_LEGAL
  UNCLEAR
}

enum ChatAttachmentExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String?
  status            UserStatus        @default(INVITED)
  passwordChangedAt DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  memberships       WorkspaceMember[]
  sessions          AuthSession[]
  tokens            AuthToken[]
  auditEvents       AuditEvent[]
  chatSessions      ChatSession[]     @relation("ChatSessionCreator")
}

model Workspace {
  id              String            @id @default(uuid())
  name            String
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  memberships     WorkspaceMember[]
  auditEvents     AuditEvent[]
  chatSessions    ChatSession[]
  chatAttachments ChatAttachment[]
  workflowJobs    WorkflowJob[]
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        WorkspaceRole         @default(MEMBER)
  status      WorkspaceMemberStatus @default(INVITED)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId, status])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  tokenFamily      String
  refreshTokenHash String
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  userAgent        String?
  ipAddress        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamily])
}

model AuthToken {
  id         String           @id @default(uuid())
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String
  expiresAt  DateTime         @db.Timestamptz(3)
  consumedAt DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, tokenHash])
  @@index([userId, purpose])
}

model AuditEvent {
  id          String     @id @default(uuid())
  userId      String?
  workspaceId String?
  eventType   String
  outcome     String
  requestId   String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model ChatSession {
  id              String            @id @default(uuid())
  workspaceId     String
  createdByUserId String
  title           String?
  status          ChatSessionStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("ChatSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages        ChatMessage[]
  attachments     ChatAttachment[]
  workflowJobs    WorkflowJob[]

  @@index([workspaceId, updatedAt])
  @@index([createdByUserId, createdAt])
}

model ChatMessage {
  id             String            @id @default(uuid())
  sessionId      String
  role           ChatMessageRole
  content        String
  status         ChatMessageStatus @default(COMPLETED)
  triageDecision TriageDecision?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  session        ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]

  @@index([sessionId, createdAt])
  @@index([correlationId])
}

model ChatAttachment {
  id               String                         @id @default(uuid())
  workspaceId      String
  sessionId        String
  messageId        String?
  originalName     String
  storedName       String
  mimeType         String
  sizeBytes        Int
  extractionStatus ChatAttachmentExtractionStatus @default(PENDING)
  extractedText    String?                        @db.Text
  extractionError  String?
  extractedAt      DateTime?                      @db.Timestamptz(3)
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  workspace        Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session          ChatSession                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message          ChatMessage?                   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, sessionId])
  @@index([messageId])
}

model WorkflowJob {
  id            String            @id @default(uuid())
  workspaceId   String
  sessionId     String
  workflowName  String
  status        WorkflowJobStatus @default(QUEUED)
  correlationId String
  input         Json?
  output        Json?
  errorCode     String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session       ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([correlationId])
}
