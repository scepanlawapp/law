generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserGender {
  MALE
  FEMALE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  LAWYER
  MEMBER
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageDecision {
  LEGAL
  NON_LEGAL
  UNCLEAR
}

enum ChatAttachmentExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ChatAttachmentSourceScript {
  LATIN
  CYRILLIC
  MIXED
  NONE
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ThemePreference {
  MIDNIGHT
  DEEP_NAVY
  CHARCOAL
  DARK_TEAL
  BURGUNDY
  IVORY
}

enum LanguagePreference {
  SR
  EN
}

enum DateTimeFormatPreference {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

enum DraftApprovalStatus {
  DRAFT
  READY_FOR_SIGNOFF
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BillingEntryKind {
  TIME
  FIXED_FEE
  EXPENSE
}

enum BillingDisposition {
  BILLABLE
  INCLUDED
  NO_CHARGE
  INTERNAL
}

enum BillingEntryLifecycle {
  DRAFT
  READY
  RESERVED
  STATEMENT_SENT
  VOIDED
}

enum BillingSuggestionResolution {
  PENDING
  RECORDED
  DISMISSED
}

enum PriceSourceScope {
  CLIENT_AGREEMENT
  WORKSPACE_PUBLIC_REFERENCE
  CASE_OVERRIDE
}

enum BillingStatementStatus {
  DRAFT
  SENT
  VOIDED
}

enum FinanceMutationOperation {
  CREATE_STATEMENT
  SEND_STATEMENT
  CREATE_PAYMENT
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PROSPECT
}

enum ClientContactStatus {
  ACTIVE
  INACTIVE
}

enum ActivityType {
  NOTE
  PHONE_CALL
  MEETING
  EMAIL
  OTHER
}

enum ActivitySource {
  MANUAL
  SYSTEM
  AI
}

enum EventType {
  MEETING
  HEARING
  CALL
  OTHER
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DeadlineType {
  COURT
  STATUTORY
  CONTRACTUAL
  INTERNAL
  OTHER
}

enum DeadlineStatus {
  OPEN
  SATISFIED
  CANCELLED
}

enum NoteType {
  GENERAL
  CALL_SUMMARY
  MEETING_SUMMARY
  CASE_UPDATE
}

enum CaseStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StorageProviderType {
  LOCAL
}

enum StoredFileLifecycle {
  PENDING
  AVAILABLE
  FAILED
  ABANDONED
}

enum FileLocationState {
  PENDING
  AVAILABLE
  FAILED
}

enum UploadOperationStatus {
  ACCEPTED
  WRITING
  FINALIZING
  COMMITTED
  FAILED
  ABANDONED
}

enum UploadOperationPurpose {
  CREATE_DOCUMENT
  ADD_VERSION
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String?
  firstName                String?
  lastName                 String?
  username                 String?                   @unique
  phone                    String?
  jobTitle                 String?
  gender                   UserGender?
  avatarUrl                String?
  status                   UserStatus                @default(INVITED)
  passwordChangedAt        DateTime?                 @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  memberships              WorkspaceMember[]
  sessions                 AuthSession[]
  tokens                   AuthToken[]
  auditEvents              AuditEvent[]
  organizedEvents          Event[]                   @relation("EventOrganizer")
  createdEvents            Event[]                   @relation("EventCreator")
  eventAssignees           EventAssignee[]
  assignedTasks            Task[]                    @relation("TaskAssignee")
  createdTasks             Task[]                    @relation("TaskCreator")
  responsibleDeadlines     Deadline[]                @relation("DeadlineResponsible")
  createdDeadlines         Deadline[]                @relation("DeadlineCreator")
  completedTasks           Task[]                    @relation("TaskCompleter")
  satisfiedDeadlines       Deadline[]                @relation("DeadlineSatisfier")
  createdNotes             Note[]                    @relation("NoteCreator")
  activityLogs             ActivityLog[]             @relation("ActivityActor")
  chatSessions             ChatSession[]             @relation("ChatSessionCreator")
  createdDocuments         Document[]                @relation("DocumentCreator")
  updatedDocuments         Document[]                @relation("DocumentUpdater")
  archivedDocuments        Document[]                @relation("DocumentArchiver")
  uploadedVersions         DocumentVersion[]         @relation("DocumentVersionUploader")
  uploadOperations         UploadOperation[]         @relation("UploadOperationActor")
  settings                 UserSettings?
  performedBillingEntries  BillingEntry[]            @relation("BillingEntryPerformer")
  createdBillingEntries    BillingEntry[]            @relation("BillingEntryCreator")
  updatedBillingEntries    BillingEntry[]            @relation("BillingEntryUpdater")
  reviewedSuggestions      BillingSuggestionReview[] @relation("BillingSuggestionReviewer")
  authoredPriceSources     PriceSource[]             @relation("PriceSourceAuthor")
  authoredPriceVersions    PriceSourceVersion[]      @relation("PriceSourceVersionAuthor")
  sharedBillingStatements  BillingStatement[]        @relation("BillingStatementSharer")
  voidedBillingStatements  BillingStatement[]        @relation("BillingStatementVoider")
  createdBillingStatements BillingStatement[]        @relation("BillingStatementCreator")
  updatedBillingStatements BillingStatement[]        @relation("BillingStatementUpdater")
  recordedPayments         ExternalPaymentRecord[]   @relation("PaymentRecorder")
  reversedPayments         ExternalPaymentRecord[]   @relation("PaymentReverser")
}

model UserSettings {
  userId                 String                   @id
  theme                  ThemePreference          @default(CHARCOAL)
  language               LanguagePreference       @default(SR)
  accentColor            String                   @default("GOLD")
  finish                 String                   @default("METALLIC")
  workspaceNotifications Boolean                  @default(true)
  dateTimeFormat         DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  timeZone               String                   @default("Europe/Belgrade")
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                     String                    @id @default(uuid())
  name                   String
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  memberships            WorkspaceMember[]
  auditEvents            AuditEvent[]
  chatSessions           ChatSession[]
  chatAttachments        ChatAttachment[]
  workflowJobs           WorkflowJob[]
  briefExtractionResults BriefExtractionResult[]
  draftResults           DraftResult[]
  config                 WorkspaceConfig?
  domainCounters         DomainCounter[]
  tags                   Tag[]
  caseTypes              CaseType[]
  practiceAreas          PracticeArea[]
  clients                Client[]
  cases                  Case[]
  clientActivities       ClientActivity[]
  caseActivities         CaseActivity[]
  caseResponsibilities   CaseResponsibility[]
  events                 Event[]
  eventAssignees         EventAssignee[]
  eventClients           EventClient[]
  eventAttendees         EventAttendee[]
  tasks                  Task[]
  deadlines              Deadline[]
  notes                  Note[]
  activityLogs           ActivityLog[]
  tenantAuditEvents      TenantAuditEvent[]
  legalSources           LegalSource[]
  storageConnections     StorageConnection[]
  documents              Document[]
  documentCases          DocumentCase[]
  documentClients        DocumentClient[]
  documentVersions       DocumentVersion[]
  storedFiles            StoredFile[]
  fileLocations          FileLocation[]
  uploadOperations       UploadOperation[]
  billingEntries         BillingEntry[]
  suggestionReviews      BillingSuggestionReview[]
  priceSources           PriceSource[]
  priceSourceVersions    PriceSourceVersion[]
  billingStatements      BillingStatement[]
  paymentRecords         ExternalPaymentRecord[]
  financeMutations       FinanceMutationRequest[]
}

model WorkspaceConfig {
  workspaceId            String                   @id
  timeZone               String                   @default("Europe/Belgrade")
  dateTimeFormat         DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  workspaceNotifications Boolean                  @default(true)
  officeHours            Json?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  workspace              Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DomainCounter {
  workspaceId String
  name        String
  value       Int       @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}

model Tag {
  id              String      @id @default(uuid())
  workspaceId     String
  name            String
  color           String?
  isActive        Boolean     @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clients         ClientTag[]
  cases           CaseTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model CaseType {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model PracticeArea {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model Client {
  id                      String                         @id @default(uuid())
  workspaceId             String
  clientNumber            String
  type                    ClientType
  displayName             String
  firstName               String?
  lastName                String?
  organizationName        String?
  isDomestic              Boolean                        @default(true)
  jmbg                    String?
  taxNumber               String?
  registrationNumber      String?
  status                  ClientStatus                   @default(ACTIVE)
  email                   String?
  phone                   String?
  website                 String?
  preferredLanguage       String?
  notes                   String?
  customFields            Json?
  responsibleUserId       String?
  createdByUserId         String
  updatedByUserId         String
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addresses               ClientAddress[]                @relation("ClientAddresses")
  identificationDocuments ClientIdentificationDocument[]
  contacts                ClientContact[]
  documentClients         DocumentClient[]
  activities              ClientActivity[]
  cases                   Case[]
  tags                    ClientTag[]
  eventClients            EventClient[]
  tasks                   Task[]
  deadlines               Deadline[]
  clientNotes             Note[]
  activityLogs            ActivityLog[]
  billingEntries          BillingEntry[]
  priceSources            PriceSource[]
  billingStatements       BillingStatement[]

  @@unique([workspaceId, clientNumber])
  @@index([workspaceId, status, displayName])
  @@index([workspaceId, type, status])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model ClientAddress {
  id               String   @id @default(uuid())
  clientId         String
  addressType      String
  street           String
  streetAdditional String?
  city             String
  postalCode       String
  stateOrRegion    String?
  country          String
  note             String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  client           Client   @relation("ClientAddresses", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientIdentificationDocument {
  id          String    @id @default(uuid())
  clientId    String
  type        String
  number      String
  issuedDate  DateTime? @db.Date
  expiredDate DateTime? @db.Date
  country     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientContact {
  id             String              @id @default(uuid())
  clientId       String
  firstName      String
  lastName       String
  position       String?
  email          String?
  phone          String?
  isPrimary      Boolean             @default(false)
  notes          String?
  status         ClientContactStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  eventAttendees EventAttendee[]

  @@index([clientId, status, lastName, firstName])
}

model ClientActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  clientId        String
  relatedCaseId   String?
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relatedCase     Case?          @relation("ClientActivityRelatedCase", fields: [relatedCaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clientId, activityDate])
  @@index([relatedCaseId])
}

model Case {
  id                   String                  @id @default(uuid())
  workspaceId          String
  caseNumber           String
  clientId             String
  name                 String
  description          String?
  caseTypeId           String?
  practiceAreaId       String?
  status               CaseStatus              @default(DRAFT)
  priority             CasePriority            @default(NORMAL)
  responsibleUserId    String
  openedDate           DateTime?               @db.Timestamptz(3)
  closedDate           DateTime?               @db.Timestamptz(3)
  closingNote          String?
  externalReference    String?
  opposingPartyName    String?
  opposingPartyAddress String?
  confidentialityLevel String?
  customFields         Json?
  createdByUserId      String
  updatedByUserId      String
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  caseType             CaseType?               @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
  practiceArea         PracticeArea?           @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  activities           CaseActivity[]
  clientActivities     ClientActivity[]        @relation("ClientActivityRelatedCase")
  responsibilities     CaseResponsibility[]
  tags                 CaseTag[]
  events               Event[]                 @relation("EventCase")
  tasks                Task[]                  @relation("TaskCase")
  deadlines            Deadline[]              @relation("DeadlineCase")
  notes                Note[]                  @relation("NoteCase")
  activityLogs         ActivityLog[]           @relation("ActivityCase")
  documentCases        DocumentCase[]
  chatSessions         ChatSession[]
  draftResults         DraftResult[]
  appliedBriefs        BriefExtractionResult[] @relation("BriefAppliedCase")
  billingEntries       BillingEntry[]
  priceSources         PriceSource[]

  @@unique([workspaceId, caseNumber])
  @@index([workspaceId, clientId, status, updatedAt])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, caseTypeId, status])
  @@index([workspaceId, practiceAreaId, status])
}

model CaseActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  caseId          String
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([workspaceId, caseId, activityDate])
}

model Event {
  id              String          @id @default(uuid())
  workspaceId     String
  type            EventType
  title           String
  description     String?
  startsAt        DateTime        @db.Timestamptz(3)
  endsAt          DateTime        @db.Timestamptz(3)
  timeZone        String
  isAllDay        Boolean         @default(false)
  status          EventStatus     @default(SCHEDULED)
  location        String?
  meetingUrl      String?
  courtName       String?
  courtroom       String?
  organizerUserId String
  caseId          String?
  createdByUserId String
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer       User            @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  case            Case?           @relation("EventCase", fields: [caseId], references: [id], onDelete: SetNull)
  assignees       EventAssignee[]
  clients         EventClient[]
  attendees       EventAttendee[]
  notes           Note[]          @relation("NoteEvent")

  @@index([workspaceId, startsAt, endsAt])
  @@index([workspaceId, status, startsAt])
  @@index([caseId])
  @@index([organizerUserId, startsAt])
}

model EventAssignee {
  workspaceId String
  eventId     String
  userId      String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([workspaceId, userId])
}

model EventClient {
  workspaceId String
  eventId     String
  clientId    String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([eventId, clientId])
  @@index([workspaceId, clientId])
}

model EventAttendee {
  id              String         @id @default(uuid())
  workspaceId     String
  eventId         String
  clientContactId String?
  displayName     String
  email           String?
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventId])
  @@index([clientContactId])
}

model Task {
  id                String       @id @default(uuid())
  workspaceId       String
  title             String
  description       String?
  status            TaskStatus   @default(TODO)
  priority          CasePriority @default(NORMAL)
  assigneeUserId    String
  dueDate           DateTime?    @db.Date
  dueAt             DateTime?    @db.Timestamptz(3)
  caseId            String?
  clientId          String?
  deadlineId        String?
  completedAt       DateTime?    @db.Timestamptz(3)
  completedByUserId String?
  createdByUserId   String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee          User         @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  createdBy         User         @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy       User?        @relation("TaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  case              Case?        @relation("TaskCase", fields: [caseId], references: [id], onDelete: SetNull)
  client            Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deadline          Deadline?    @relation("DeadlineTasks", fields: [deadlineId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, assigneeUserId, status])
  @@index([workspaceId, dueAt])
  @@index([caseId])
  @@index([clientId])
  @@index([deadlineId])
}

model Deadline {
  id                String         @id @default(uuid())
  workspaceId       String
  title             String
  description       String?
  type              DeadlineType
  dueDate           DateTime?      @db.Date
  dueAt             DateTime?      @db.Timestamptz(3)
  timeZone          String?
  status            DeadlineStatus @default(OPEN)
  responsibleUserId String
  caseId            String?
  clientId          String?
  sourceDescription String?
  satisfiedAt       DateTime?      @db.Timestamptz(3)
  satisfiedByUserId String?
  createdByUserId   String
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responsibleUser   User           @relation("DeadlineResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  satisfiedBy       User?          @relation("DeadlineSatisfier", fields: [satisfiedByUserId], references: [id], onDelete: SetNull)
  createdBy         User           @relation("DeadlineCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  case              Case?          @relation("DeadlineCase", fields: [caseId], references: [id], onDelete: SetNull)
  client            Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks             Task[]         @relation("DeadlineTasks")

  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, dueAt])
  @@index([caseId])
  @@index([clientId])
}

model Note {
  id              String    @id @default(uuid())
  workspaceId     String
  type            NoteType
  body            String    @db.Text
  occurredAt      DateTime  @db.Timestamptz(3)
  caseId          String?
  clientId        String?
  eventId         String?
  createdByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case            Case?     @relation("NoteCase", fields: [caseId], references: [id], onDelete: SetNull)
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  event           Event?    @relation("NoteEvent", fields: [eventId], references: [id], onDelete: SetNull)
  createdBy       User      @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, type, occurredAt])
  @@index([caseId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([eventId])
}

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
