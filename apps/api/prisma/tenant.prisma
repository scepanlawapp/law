generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageDecision {
  LEGAL
  NON_LEGAL
  UNCLEAR
}

enum ChatAttachmentExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ChatAttachmentSourceScript {
  LATIN
  CYRILLIC
  MIXED
  NONE
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DraftApprovalStatus {
  DRAFT
  READY_FOR_SIGNOFF
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DateTimeFormatPreference {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

enum PartyType {
  PERSON
  ORGANIZATION
}

enum PartyContactPointType {
  EMAIL
  PHONE
  MOBILE
  FAX
  WEBSITE
  OTHER
}

enum PartyIdentifierType {
  NATIONAL_ID
  TAX_ID
  REGISTRATION_ID
  PASSPORT
  ID_CARD
  VAT_ID
  OTHER
}

enum PartyAddressType {
  PRIMARY
  REGISTERED
  MAILING
  BILLING
  OTHER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum MatterState {
  DRAFT
  OPEN
  CLOSED
}

enum MatterPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProceedingStatus {
  OPEN
  SUSPENDED
  CLOSED
  OTHER
}

model WorkspaceConfig {
  workspaceId            String                   @id
  timeZone               String                   @default("Europe/Belgrade")
  dateTimeFormat         DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  workspaceNotifications Boolean                  @default(true)
  officeHours            Json?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
}

model ChatSession {
  id                     String                  @id @default(uuid())
  workspaceId            String
  createdByUserId        String
  title                  String?
  status                 ChatSessionStatus       @default(ACTIVE)
  isDeleted              Boolean                 @default(false)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  messages               ChatMessage[]
  attachments            ChatAttachment[]
  workflowJobs           WorkflowJob[]
  briefExtractionResults BriefExtractionResult[]
  draftResults           DraftResult[]

  @@index([workspaceId, updatedAt])
  @@index([createdByUserId, isDeleted, createdAt])
}

model ChatMessage {
  id                     String                  @id @default(uuid())
  sessionId              String
  role                   ChatMessageRole
  content                String
  status                 ChatMessageStatus       @default(COMPLETED)
  triageDecision         TriageDecision?
  correlationId          String?
  metadata               Json?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  session                ChatSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments            ChatAttachment[]
  briefExtractionResults BriefExtractionResult[]
  draftResults           DraftResult[]

  @@index([sessionId, createdAt])
  @@index([correlationId])
}

model ChatAttachment {
  id               String                         @id @default(uuid())
  workspaceId      String
  sessionId        String
  messageId        String?
  originalName     String
  storedName       String
  mimeType         String
  sizeBytes        Int
  extractionStatus ChatAttachmentExtractionStatus @default(PENDING)
  extractedText    String?                        @db.Text
  sourceScript     ChatAttachmentSourceScript?
  extractionError  String?
  extractedAt      DateTime?                      @db.Timestamptz(3)
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  session          ChatSession                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message          ChatMessage?                   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, sessionId])
  @@index([messageId])
}

model WorkflowJob {
  id                    String                 @id @default(uuid())
  workspaceId           String
  sessionId             String
  workflowName          String
  status                WorkflowJobStatus      @default(QUEUED)
  correlationId         String
  input                 Json?
  output                Json?
  errorCode             String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  session               ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  briefExtractionResult BriefExtractionResult?
  draftResult           DraftResult?

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([correlationId])
}

model BriefExtractionResult {
  id            String        @id @default(uuid())
  jobId         String        @unique
  workspaceId   String
  sessionId     String
  messageId     String?
  brief         Json
  confidence    Float?
  missingFields String[]      @default([])
  promptChars   Int
  truncated     Boolean       @default(false)
  model         String
  errorCode     String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  job           WorkflowJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session       ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message       ChatMessage?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  draftResults  DraftResult[]

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
}

model DraftResult {
  id                String                 @id @default(uuid())
  jobId             String                 @unique
  workspaceId       String
  sessionId         String
  messageId         String?
  briefResultId     String?
  documentText      String                 @db.Text
  finalDocumentText String?                @db.Text
  warnings          String[]               @default([])
  promptChars       Int
  truncated         Boolean                @default(false)
  model             String
  approvalStatus    DraftApprovalStatus    @default(READY_FOR_SIGNOFF)
  reviewedByUserId  String?
  reviewedAt        DateTime?              @db.Timestamptz(3)
  reviewNote        String?
  previousDraftId   String?
  errorCode         String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  job               WorkflowJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session           ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message           ChatMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  briefResult       BriefExtractionResult? @relation(fields: [briefResultId], references: [id], onDelete: SetNull)
  previousDraft     DraftResult?           @relation("DraftResultHistory", fields: [previousDraftId], references: [id], onDelete: SetNull)
  modifiedDrafts    DraftResult[]          @relation("DraftResultHistory")

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([approvalStatus, reviewedAt])
}

model TenantAuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  eventType   String
  outcome     String
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model Party {
  id                String                @id @default(uuid())
  workspaceId       String
  type              PartyType
  firstName         String?
  lastName          String?
  legalName         String?
  tradeName         String?
  displayName       String
  notes             String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  createdByUserId   String?
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  updatedByUserId   String?
  archivedAt        DateTime?             @db.Timestamptz(3)
  contactPoints     PartyContactPoint[]
  identifiers       PartyIdentifier[]
  addresses         PartyAddress[]
  outgoingRelations PartyRelationship[]   @relation("PartyRelationshipFrom")
  incomingRelations PartyRelationship[]   @relation("PartyRelationshipTo")
  clients           Client[]
  participants      MatterParticipant[]

  @@index([workspaceId, displayName])
  @@index([workspaceId, type])
}

model PartyContactPoint {
  id        String                 @id @default(uuid())
  partyId   String
  type      PartyContactPointType
  value     String
  label     String?
  isPrimary Boolean                @default(false)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  party     Party                  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
  @@index([type, value])
}

model PartyIdentifier {
  id          String               @id @default(uuid())
  partyId     String
  type        PartyIdentifierType
  value       String
  countryCode String?
  issuer      String?
  isPrimary   Boolean              @default(false)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  party       Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
  @@index([type, value])
}

model PartyAddress {
  id            String          @id @default(uuid())
  partyId       String
  type          PartyAddressType @default(PRIMARY)
  addressLine1  String
  addressLine2  String?
  city          String?
  postalCode    String?
  region        String?
  countryCode   String?
  isPrimary     Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  party         Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
}

model OrganizationRelationshipType {
  id                String              @id @default(uuid())
  workspaceId       String
  code              String
  name              String
  isActive          Boolean             @default(true)
  isSystemSeed      Boolean             @default(false)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  relationships     PartyRelationship[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive, sortOrder])
}

model PartyRelationship {
  id                   String                       @id @default(uuid())
  workspaceId          String
  fromPartyId          String
  toPartyId            String
  relationshipTypeId    String
  jobTitle             String?
  department           String?
  isPrimaryContact     Boolean                      @default(false)
  isActive             Boolean                      @default(true)
  notes                String?
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  fromParty            Party                        @relation("PartyRelationshipFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toParty              Party                        @relation("PartyRelationshipTo", fields: [toPartyId], references: [id], onDelete: Cascade)
  relationshipType     OrganizationRelationshipType @relation(fields: [relationshipTypeId], references: [id], onDelete: Restrict)

  @@unique([fromPartyId, toPartyId, relationshipTypeId])
  @@index([workspaceId, fromPartyId, isActive])
  @@index([workspaceId, toPartyId, isActive])
}

model Client {
  id              String       @id @default(uuid())
  workspaceId     String
  partyId         String
  clientCode      String
  status          ClientStatus @default(ACTIVE)
  responsibleUserId String?
  openedAt        DateTime     @default(now()) @db.Timestamptz(3)
  closedAt        DateTime?    @db.Timestamptz(3)
  notes           String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  createdByUserId String?
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  updatedByUserId String?
  archivedAt      DateTime?    @db.Timestamptz(3)
  party           Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  matters         MatterClient[]

  @@unique([workspaceId, clientCode])
  @@unique([workspaceId, partyId])
  @@index([workspaceId, status])
  @@index([workspaceId, partyId])
}

model PracticeArea {
  id           String        @id @default(uuid())
  workspaceId  String
  code         String
  name         String
  parentId     String?
  isActive     Boolean       @default(true)
  isSystemSeed Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  parent       PracticeArea? @relation("PracticeAreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     PracticeArea[] @relation("PracticeAreaTree")
  stages       MatterStage[]
  matters      Matter[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive, sortOrder])
}

model MatterStage {
  id            String       @id @default(uuid())
  workspaceId   String
  code          String
  name          String
  practiceAreaId String?
  isActive      Boolean      @default(true)
  isSystemSeed  Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  practiceArea  PracticeArea? @relation(fields: [practiceAreaId], references: [id], onDelete: Restrict)
  matters       Matter[]

  @@unique([workspaceId, code])
  @@index([workspaceId, practiceAreaId, isActive, sortOrder])
}

model ParticipantRole {
  id          String                  @id @default(uuid())
  workspaceId String
  code        String
  name        String
  isActive    Boolean                 @default(true)
  isSystemSeed Boolean                @default(false)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  assignments MatterParticipantRole[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive, sortOrder])
}

model ProceedingType {
  id          String        @id @default(uuid())
  workspaceId String
  code        String
  name        String
  isActive    Boolean       @default(true)
  isSystemSeed Boolean      @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  proceedings Proceeding[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive, sortOrder])
}

model DocumentCategory {
  id          String       @id @default(uuid())
  workspaceId String
  code        String
  name        String
  isActive    Boolean      @default(true)
  isSystemSeed Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive, sortOrder])
}

model MatterNumberCounter {
  workspaceId String
  year        Int
  nextValue   Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@id([workspaceId, year])
}

model Matter {
  id              String        @id @default(uuid())
  workspaceId     String
  internalNumber  String?
  title           String
  state           MatterState   @default(DRAFT)
  practiceAreaId  String?
  stageId         String?
  priority        MatterPriority @default(NORMAL)
  responsibleUserId String?
  description     String?
  openedAt        DateTime?     @db.Timestamptz(3)
  closedAt        DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  createdByUserId String?
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  updatedByUserId String?
  archivedAt      DateTime?     @db.Timestamptz(3)
  practiceArea    PracticeArea? @relation(fields: [practiceAreaId], references: [id], onDelete: Restrict)
  stage           MatterStage?  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  clients         MatterClient[]
  participants    MatterParticipant[]
  proceedings     Proceeding[]

  @@unique([workspaceId, internalNumber])
  @@index([workspaceId, state])
  @@index([workspaceId, priority])
  @@index([workspaceId, practiceAreaId])
  @@index([workspaceId, responsibleUserId])
}

model MatterClient {
  id        String   @id @default(uuid())
  matterId  String
  clientId  String
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([matterId, clientId])
  @@index([clientId])
}

model MatterParticipant {
  id           String                  @id @default(uuid())
  matterId     String
  partyId      String
  notes        String?
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  matter       Matter                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  party        Party                   @relation(fields: [partyId], references: [id], onDelete: Restrict)
  roles        MatterParticipantRole[]

  @@unique([matterId, partyId])
  @@index([partyId])
}

model MatterParticipantRole {
  id            String            @id @default(uuid())
  participantId String
  roleId        String
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  participant   MatterParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  role          ParticipantRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([participantId, roleId])
  @@index([roleId])
}

model Proceeding {
  id             String           @id @default(uuid())
  workspaceId    String
  matterId       String
  typeId         String
  externalNumber String?
  authorityName  String?
  judgeName      String?
  status         ProceedingStatus?
  startedAt      DateTime?        @db.Timestamptz(3)
  endedAt        DateTime?        @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  matter         Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  type           ProceedingType   @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([workspaceId, matterId])
  @@index([workspaceId, externalNumber])
}
