generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TriageDecision {
  LEGAL
  NON_LEGAL
  UNCLEAR
}

enum ChatAttachmentExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ChatAttachmentSourceScript {
  LATIN
  CYRILLIC
  MIXED
  NONE
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DraftApprovalStatus {
  DRAFT
  READY_FOR_SIGNOFF
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DateTimeFormatPreference {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

enum ClientType {
  INDIVIDUAL
  ORGANIZATION
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PROSPECT
}

enum ClientAddressType {
  MAIN
  BILLING
  REGISTERED
  MAILING
  OTHER
}

enum ClientContactStatus {
  ACTIVE
  INACTIVE
}

enum ActivityType {
  NOTE
  PHONE_CALL
  MEETING
  EMAIL
  OTHER
}

enum ActivitySource {
  MANUAL
  SYSTEM
  AI
}

enum CaseStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkspaceConfig {
  workspaceId            String                   @id
  timeZone               String                   @default("Europe/Belgrade")
  dateTimeFormat         DateTimeFormatPreference @default(TWENTY_FOUR_HOUR)
  workspaceNotifications Boolean                  @default(true)
  officeHours            Json?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
}

model DomainCounter {
  workspaceId String
  name        String
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@id([workspaceId, name])
}

model Tag {
  id              String      @id @default(uuid())
  workspaceId     String
  name            String
  color           String?
  isActive        Boolean     @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  clients         ClientTag[]
  cases           CaseTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model CaseType {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean  @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model PracticeArea {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  isActive        Boolean  @default(true)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  cases           Case[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive, name])
}

model Client {
  id                String         @id @default(uuid())
  workspaceId       String
  clientNumber      String
  type              ClientType
  displayName       String
  firstName         String?
  lastName          String?
  organizationName  String?
  status            ClientStatus   @default(ACTIVE)
  email             String?
  phone             String?
  website           String?
  preferredLanguage String?
  notes             String?
  customFields      Json?
  responsibleUserId String?
  primaryAddressId  String?        @unique
  createdByUserId   String
  updatedByUserId   String
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  addresses         ClientAddress[] @relation("ClientAddresses")
  primaryAddress    ClientAddress? @relation("ClientPrimaryAddress", fields: [primaryAddressId], references: [id], onDelete: SetNull)
  contacts          ClientContact[]
  activities        ClientActivity[]
  cases             Case[]
  tags              ClientTag[]

  @@unique([workspaceId, clientNumber])
  @@index([workspaceId, status, displayName])
  @@index([workspaceId, type, status])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model ClientAddress {
  id               String            @id @default(uuid())
  clientId         String
  type             ClientAddressType @default(MAIN)
  street           String?
  streetAdditional String?
  city             String?
  postalCode       String?
  stateOrRegion    String?
  country          String?
  isPrimary        Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  client           Client            @relation("ClientAddresses", fields: [clientId], references: [id], onDelete: Cascade)
  primaryForClient Client?           @relation("ClientPrimaryAddress")

  @@index([clientId, createdAt])
}

model ClientContact {
  id        String              @id @default(uuid())
  clientId  String
  firstName String
  lastName  String
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean             @default(false)
  notes     String?
  status    ClientContactStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status, lastName, firstName])
}

model ClientActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  clientId        String
  relatedCaseId   String?
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  relatedCase     Case?          @relation("ClientActivityRelatedCase", fields: [relatedCaseId], references: [id], onDelete: SetNull)

  @@index([workspaceId, clientId, activityDate])
  @@index([relatedCaseId])
}

model Case {
  id                   String             @id @default(uuid())
  workspaceId          String
  caseNumber           String
  clientId             String
  name                 String
  description          String?
  caseTypeId           String?
  practiceAreaId       String?
  status               CaseStatus         @default(DRAFT)
  priority             CasePriority       @default(NORMAL)
  responsibleUserId    String
  openedDate           DateTime?          @db.Timestamptz(3)
  closedDate           DateTime?          @db.Timestamptz(3)
  closingNote          String?
  externalReference    String?
  confidentialityLevel String?
  customFields         Json?
  createdByUserId      String
  updatedByUserId      String
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  caseType             CaseType?          @relation(fields: [caseTypeId], references: [id], onDelete: SetNull)
  practiceArea         PracticeArea?      @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  activities           CaseActivity[]
  clientActivities     ClientActivity[]   @relation("ClientActivityRelatedCase")
  responsibilities     CaseResponsibility[]
  tags                 CaseTag[]

  @@unique([workspaceId, caseNumber])
  @@index([workspaceId, clientId, status, updatedAt])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, responsibleUserId, status])
  @@index([workspaceId, caseTypeId, status])
  @@index([workspaceId, practiceAreaId, status])
}

model CaseActivity {
  id              String         @id @default(uuid())
  workspaceId     String
  caseId          String
  type            ActivityType
  title           String
  description     String?
  activityDate    DateTime       @db.Timestamptz(3)
  source          ActivitySource @default(MANUAL)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([workspaceId, caseId, activityDate])
}

model CaseResponsibility {
  id              String    @id @default(uuid())
  workspaceId     String
  caseId          String
  userId          String
  isPrimary       Boolean   @default(false)
  startedAt       DateTime  @default(now()) @db.Timestamptz(3)
  endedAt         DateTime? @db.Timestamptz(3)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([workspaceId, caseId, endedAt])
  @@index([workspaceId, userId, endedAt])
}

model ClientTag {
  clientId String
  tagId    String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId, clientId])
}

model CaseTag {
  caseId String
  tagId  String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseId, tagId])
  @@index([tagId, caseId])
}

model ChatSession {
  id                     String                  @id @default(uuid())
  workspaceId            String
  createdByUserId        String
  title                  String?
  status                 ChatSessionStatus       @default(ACTIVE)
  isDeleted              Boolean                 @default(false)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  messages               ChatMessage[]
  attachments            ChatAttachment[]
  workflowJobs           WorkflowJob[]
  briefExtractionResults BriefExtractionResult[]
  draftResults           DraftResult[]

  @@index([workspaceId, updatedAt])
  @@index([createdByUserId, isDeleted, createdAt])
}

model ChatMessage {
  id                     String                  @id @default(uuid())
  sessionId              String
  role                   ChatMessageRole
  content                String
  status                 ChatMessageStatus       @default(COMPLETED)
  triageDecision         TriageDecision?
  correlationId          String?
  metadata               Json?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  session                ChatSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments            ChatAttachment[]
  briefExtractionResults BriefExtractionResult[]
  draftResults           DraftResult[]

  @@index([sessionId, createdAt])
  @@index([correlationId])
}

model ChatAttachment {
  id               String                         @id @default(uuid())
  workspaceId      String
  sessionId        String
  messageId        String?
  originalName     String
  storedName       String
  mimeType         String
  sizeBytes        Int
  extractionStatus ChatAttachmentExtractionStatus @default(PENDING)
  extractedText    String?                        @db.Text
  sourceScript     ChatAttachmentSourceScript?
  extractionError  String?
  extractedAt      DateTime?                      @db.Timestamptz(3)
  createdAt        DateTime                       @default(now()) @db.Timestamptz(3)
  session          ChatSession                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message          ChatMessage?                   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId, sessionId])
  @@index([messageId])
}

model WorkflowJob {
  id                    String                 @id @default(uuid())
  workspaceId           String
  sessionId             String
  workflowName          String
  status                WorkflowJobStatus      @default(QUEUED)
  correlationId         String
  input                 Json?
  output                Json?
  errorCode             String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  session               ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  briefExtractionResult BriefExtractionResult?
  draftResult           DraftResult?

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([correlationId])
}

model BriefExtractionResult {
  id            String        @id @default(uuid())
  jobId         String        @unique
  workspaceId   String
  sessionId     String
  messageId     String?
  brief         Json
  confidence    Float?
  missingFields String[]      @default([])
  promptChars   Int
  truncated     Boolean       @default(false)
  model         String
  errorCode     String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  job           WorkflowJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session       ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message       ChatMessage?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  draftResults  DraftResult[]

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
}

model DraftResult {
  id                String                 @id @default(uuid())
  jobId             String                 @unique
  workspaceId       String
  sessionId         String
  messageId         String?
  briefResultId     String?
  documentText      String                 @db.Text
  finalDocumentText String?                @db.Text
  warnings          String[]               @default([])
  promptChars       Int
  truncated         Boolean                @default(false)
  model             String
  approvalStatus    DraftApprovalStatus    @default(READY_FOR_SIGNOFF)
  reviewedByUserId  String?
  reviewedAt        DateTime?              @db.Timestamptz(3)
  reviewNote        String?
  previousDraftId   String?
  errorCode         String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  job               WorkflowJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session           ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message           ChatMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  briefResult       BriefExtractionResult? @relation(fields: [briefResultId], references: [id], onDelete: SetNull)
  previousDraft     DraftResult?           @relation("DraftResultHistory", fields: [previousDraftId], references: [id], onDelete: SetNull)
  modifiedDrafts    DraftResult[]          @relation("DraftResultHistory")

  @@index([workspaceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([approvalStatus, reviewedAt])
}

model TenantAuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  workspaceId String?
  eventType   String
  outcome     String
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}
