NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://law:law@localhost:5432/law
REDIS_URL=redis://localhost:6379
# BullMQ retry attempts per workflow job (exponential backoff, 2s base delay)
WORKFLOW_QUEUE_ATTEMPTS=3

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=replace-with-a-local-secret

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal-templates

UPLOAD_MAX_BYTES=25000000
CHAT_MAX_FILES_PER_MESSAGE=5
CHAT_UPLOAD_DIR=./tmp/chat-uploads
TESSDATA_DIR=./tessdata
# Scanned-PDF OCR fallback: trigger below this many text-layer chars; 0 pages disables it
PDF_OCR_MIN_TEXT_CHARS=50
PDF_OCR_MAX_PAGES=20
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
LOG_LEVEL=info

AUTH_COOKIE_NAME=law_session
AUTH_SESSION_TTL_DAYS=7
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_FRONTEND_ORIGIN=http://localhost:4200
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@law.local

# One-time local/admin bootstrap. Keep these outside source control.
AUTH_BOOTSTRAP_EMAIL=admin@example.test
AUTH_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
AUTH_BOOTSTRAP_WORKSPACE="Default workspace"
# RFC 4122 UUID required (@IsUUID). Do not use 00000000-0000-0000-0000-000000000001.
AUTH_BOOTSTRAP_WORKSPACE_ID=11111111-1111-4111-a111-111111111111
# Set true only when intentionally rotating the bootstrap user's password.
AUTH_BOOTSTRAP_FORCE_PASSWORD_RESET=false

# Optional API E2E credentials. Keep unset unless running the authenticated journey.
AUTH_E2E_EMAIL=
AUTH_E2E_PASSWORD=